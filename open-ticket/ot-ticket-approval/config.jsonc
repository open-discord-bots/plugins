{
    /* Enable or disable the whole approval workflow without removing the plugin. */
    "enabled":true,

    /* The channel where ticket requests must be approved. Get the ID by right-clicking a channel > Copy Channel ID. */
    /* Leave this empty (or invalid) and the plugin will not block any tickets. */
    "approvalChannelId":"APPROVAL-CHANNEL-ID",

    /* Optional: a role that gets pinged in the approval channel when a new request arrives. Empty to disable. */
    "notifyRoleId":"NOTIFY-ROLE-ID",

    /* Optional: additional roles that are allowed to approve/reject requests, on top of the Open Ticket "support" permission. */
    "extraApproverRoleIds":[],

    /* Staff (Open Ticket admin/support roles) can open tickets directly, without approval. */
    "staffBypassApproval":false,

    /* If the approval channel is missing, still open tickets directly (recommended) instead of blocking everything. */
    "allowTicketsWhenChannelInvalid":true,

    /* Staff must fill in a reason when rejecting. The reason is sent to the member in a DM. */
    "requireReasonOnReject":true,

    /* DM the member when their request is approved, with a link to the new ticket. */
    "dmRequesterOnApprove":true,

    /* DM the member when their request is rejected, including the rejection reason. */
    "dmRequesterOnReject":true,

    /* Requests older than this many hours can no longer be approved or rejected. 0 disables the expiry. */
    "requestExpiryHours":72,

    /* How many answers of the request are shown in the approval message (max 25 embed fields). */
    "maxAnswersShown":8
}
